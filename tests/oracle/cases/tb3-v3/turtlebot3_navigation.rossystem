# TurtleBot 3 -- guided navigation with voice confirmation on arrival.
# Operator supplies a goal pose; Nav2 drives the base to it over a closed
# cmd_vel loop; on arrival the system speaks a confirmation back.
#
# v3 (2026-07-23), replacing the earlier TurtleBot 2 attempt after feedback_v2.md:
# TurtleBot 2/Kobuki has no RosModelsCatalog coverage at all, which forced every
# base-platform node in that version to be a "disclosed inference" with no backing
# .ros2 file -- a violation of the "every from:/node needs a companion .ros2" rule.
# TurtleBot 3 IS fully catalogued (assets/rosmodelscatalog/robots/turtlebot3/), so
# this version's base-platform nodes (turtlebot3_node, hlds_laser_publisher,
# robot_state_publisher) are real catalogue entries, verified against
# assets/node_index.json -- nothing below is invented. Only mission_manager and
# voice_announcer remain project-local (no equivalent exists in any catalogue),
# and each has its own real companion file under rosnodes/.
#
# Every from: line below carries a trailing comment naming exactly which file it
# resolves to -- either a real path under assets/rosmodelscatalog/ (a pre-existing
# file this session did NOT write), or an explicit "project-local" note pointing at
# the companion file under rosnodes/ that this session DID write. Don't infer which
# is which from the node name; read the comment on that line.
#
# Interface-label convention (project style, not a DSL requirement -- the upstream
# catalogue itself uses plain names like "tf"/"odom" with no suffix): every local
# label below is suffixed by port kind -- "_pub"/"_sub" for topics, "_action" for
# both action servers and action clients. Service ports would get "_srv" but this
# system happens not to use any.
#
# tf: turtlebot3_node, robot_state_publisher and amcl each publish part of the tf
# tree; bt_navigator is the only consumer modeled here, so all three fan in to its
# single tf subscriber below (one topic, multiple publishers -- normal ROS fan-in,
# not a modeling error).
turtlebot3_navigation:
  fromFile: "turtlebot3_bringup/launch/robot.launch.py"
  nodes:
    # Base platform: drives the wheels, reports odometry, broadcasts the base's tf.
    "turtlebot3_node":
      from: "turtlebot3_node.turtlebot3_node" # assets/rosmodelscatalog/robots/turtlebot3/robot/turtlebot3_node.ros2
      interfaces:
        - "odom_pub": pub-> "turtlebot3_node::odom" # nav_msgs/msg/Odometry, feeds bt_navigator and controller_server
        - "tf_base_pub": pub-> "turtlebot3_node::tf" # tf2_msgs/msg/TFMessage, part of the tf fan-in to bt_navigator
        - "cmd_vel_sub": sub-> "turtlebot3_node::cmd_vel" # geometry_msgs/msg/Twist, arrives from controller_server -- closes the loop
    # Sensing: 2D lidar, the only exteroceptive sensor in this system
    "hlds_laser_publisher":
      from: "hlds_laser_publisher.hlds_laser_publisher" # assets/rosmodelscatalog/robots/turtlebot3/robot/hlds_laser_publisher.ros2
      interfaces:
        - "scan_pub": pub-> "hlds_laser_publisher::scan" # sensor_msgs/msg/LaserScan, feeds amcl
    # TF broadcaster: publishes the static/dynamic transforms between robot links.
    # joint_states is declared below but left unconnected -- no joint-state publisher
    # is modeled in this simplified system. The catalogued robot_description
    # publisher is omitted entirely (no consumer modeled here).
    "robot_state_publisher":
      from: "robot_state_publisher.robot_state_publisher" # assets/rosmodelscatalog/common/robot_state_publisher.ros2
      interfaces:
        - "tf_rsp_pub": pub-> "robot_state_publisher::tf" # tf2_msgs/msg/TFMessage, part of the tf fan-in to bt_navigator
        - "tf_static_pub": pub-> "robot_state_publisher::tf_static" # tf2_msgs/msg/TFMessage, static transforms
        - "joint_states_sub": sub-> "robot_state_publisher::joint_states" # sensor_msgs/msg/JointState -- declared for documentation, no publisher modeled here, left unconnected
    # Localization: particle-filter localizer. Catalogued interfaces also include
    # initialpose/map subscribers and a particle_cloud/~_pose publisher set --
    # omitted here as out of scope (no map_server/rviz modeled in this composition).
    "amcl":
      from: "amcl.amcl" # assets/rosmodelscatalog/navigation/amcl.ros2
      interfaces:
        - "tf_amcl_pub": pub-> "amcl::tf" # tf2_msgs/msg/TFMessage, part of the tf fan-in to bt_navigator
        - "scan_sub": sub-> "amcl::scan" # sensor_msgs/msg/LaserScan, from hlds_laser_publisher
    # Planning & control (Nav2): global path planner. Its compute_path_to_pose action
    # server is real and catalogued, but nothing in this composition can legitimately
    # client it -- that call happens inside Nav2's behavior-tree XML, internal to the
    # bt_navigator process, not expressible as a top-level connection at this
    # modeling granularity. Declared for documentation; left out of connections:.
    "planner_server":
      from: "planner_server.planner_server" # assets/rosmodelscatalog/navigation/planner_server.ros2
      interfaces:
        - "compute_path_to_pose_action": as-> "planner_server::compute_path_to_pose"
    # Planning & control (Nav2): local trajectory follower, turns the planned path
    # into velocity commands. follow_path is real and catalogued but left
    # unconnected for the same reason as planner_server's compute_path_to_pose, above.
    "controller_server":
      from: "controller_server.controller_server" # assets/rosmodelscatalog/navigation/controller_server.ros2
      interfaces:
        - "cmd_vel_pub": pub-> "controller_server::cmd_vel_nav" # geometry_msgs/msg/Twist, out to turtlebot3_node -- closes the control loop
        - "odom_ctrl_sub": sub-> "controller_server::odom" # nav_msgs/msg/Odometry, from turtlebot3_node
        - "follow_path_action": as-> "controller_server::follow_path"
    # Planning & control (Nav2): behavior-tree orchestrator, the single entry point
    # for "go here". Catalogued interfaces also include a navigate_through_poses
    # action server (unused by this mission), a navigate_to_pose actionclient slot
    # of its own (an internal Nav2 quirk -- nothing in this simplified composition
    # offers a matching server for it, so it stays undeclared here), and a
    # goal_pose topic subscriber (an alternate, non-action goal-entry path that
    # this system doesn't use since mission_manager drives navigate_to_pose
    # directly) -- all three omitted, not just the two mentioned above.
    "bt_navigator":
      from: "bt_navigator.bt_navigator" # assets/rosmodelscatalog/navigation/bt_navigator.ros2
      interfaces:
        - "odom_sub": sub-> "bt_navigator::odom" # nav_msgs/msg/Odometry, from turtlebot3_node
        - "tf_btnav_sub": sub-> "bt_navigator::tf" # tf2_msgs/msg/TFMessage, fan-in from turtlebot3_node/robot_state_publisher/amcl
        - "tf_static_btnav_sub": sub-> "bt_navigator::tf_static" # tf2_msgs/msg/TFMessage, from robot_state_publisher
        - "navigate_to_pose_action": as-> "bt_navigator::navigate_to_pose" # exposed to mission_manager -- the goal comes in here
    # Mission & HMI: accepts the operator's goal, drives the NavigateToPose action, reports status
    "mission_manager":
      from: "turtlebot3_mission_manager.mission_manager" # project-local, not catalogued -- see rosnodes/turtlebot3_mission_manager.ros2
      interfaces:
        - "nav_status_pub": pub-> "mission_manager::nav_status" # std_msgs/msg/String, out to voice_announcer
        - "goal_pose_sub": sub-> "mission_manager::goal_pose" # geometry_msgs/msg/PoseStamped -- from the operator, no in-system publisher
        - "navigate_to_pose_client_action": ac-> "mission_manager::navigate_to_pose"
    # Mission & HMI: speaks nav_status back to the operator (audio synthesis happens outside this graph)
    "voice_announcer":
      from: "turtlebot3_voice_announcer.voice_announcer" # project-local, not catalogued -- see rosnodes/turtlebot3_voice_announcer.ros2
      interfaces:
        - "nav_status_sub": sub-> "voice_announcer::nav_status"
  connections:
    - [scan_pub, scan_sub] # hlds_laser_publisher -> amcl : sensor_msgs/msg/LaserScan
    - [odom_pub, odom_sub] # turtlebot3_node -> bt_navigator : nav_msgs/msg/Odometry
    - [odom_pub, odom_ctrl_sub] # turtlebot3_node -> controller_server : nav_msgs/msg/Odometry (same publisher, two subscribers)
    - [tf_base_pub, tf_btnav_sub] # turtlebot3_node -> bt_navigator : tf2_msgs/msg/TFMessage
    - [tf_rsp_pub, tf_btnav_sub] # robot_state_publisher -> bt_navigator : tf2_msgs/msg/TFMessage
    - [tf_amcl_pub, tf_btnav_sub] # amcl -> bt_navigator : tf2_msgs/msg/TFMessage
    - [tf_static_pub, tf_static_btnav_sub] # robot_state_publisher -> bt_navigator : tf2_msgs/msg/TFMessage
    - [cmd_vel_pub, cmd_vel_sub] # controller_server -> turtlebot3_node : geometry_msgs/msg/Twist -- closes the loop
    - [navigate_to_pose_action, navigate_to_pose_client_action] # bt_navigator <- mission_manager : nav2_msgs/action/NavigateToPose
    - [nav_status_pub, nav_status_sub] # mission_manager -> voice_announcer : std_msgs/msg/String
