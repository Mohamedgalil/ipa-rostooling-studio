{
  "rostooling": {
    "command": "${ROSMODEL_JAVA:-java}",
    "args": [
      "-cp",
      "${CLAUDE_PLUGIN_ROOT}/build/ros2-ls/target/de.fraunhofer.ipa.rostooling.ls-3.1.0-SNAPSHOT-ls.jar",
      "org.eclipse.xtext.ide.server.ServerLauncher"
    ],
    "transport": "stdio",
    "extensionToLanguage": {
      ".ros": "ros",
      ".ros2": "ros2",
      ".rossystem": "rossystem"
    },
    "startupTimeout": 60000,
    "shutdownTimeout": 10000,
    "restartOnCrash": false,
    "diagnostics": true
  }
}
